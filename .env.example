# Backend secrets — 复制为 .env 并填入真实值（.env 已被 gitignore，请勿提交）
# docker-compose 会自动从根目录的 .env 注入这些变量

# JWT 签名密钥，可用以下命令生成：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here

# DeepSeek API key，从 https://platform.deepseek.com 后台获取
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
